{
    "name": "cross_roads",
    "version": "2.1.0",
    "description": "Need to cross the road without colliding with a moving vehicle.",
    "packageManager": "pnpm@11.5.1",
    "type": "module",
    "dependencies": {
        "@drk4/game-engine": "^3.0.1",
        "@drk4/utilities": "^7.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.16"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "arrowParens": "always",
        "htmlWhitespaceSensitivity": "strict",
        "endOfLine": "lf"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "format:check": "prettier --check \"**/*.{html,css,json,js,ts,md}\"",
        "format:run": "prettier --write \"**/*.{html,css,json,js,ts,md}\"",
        "check:types": "tsc -p tsconfig.json --noEmit --skipLibCheck",
        "lint": "eslint source"
    }
}
