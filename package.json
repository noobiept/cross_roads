{
    "name": "cross_roads",
    "version": "2.0.0",
    "description": "Need to cross the road without colliding with a moving vehicle.",
    "packageManager": "pnpm@11.5.0",
    "type": "module",
    "dependencies": {
        "@drk4/utilities": "^6.4.0",
        "easeljs": "^1.0.2",
        "preloadjs": "^1.0.1",
        "soundjs": "^1.0.1",
        "tweenjs": "^1.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/createjs-lib": "^0.0.33",
        "@types/easeljs": "^1.0.5",
        "@types/preloadjs": "^0.6.36",
        "@types/soundjs": "^0.6.31",
        "@types/tweenjs": "^1.0.8",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.14"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "arrowParens": "always",
        "htmlWhitespaceSensitivity": "strict",
        "endOfLine": "lf"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "format:check": "prettier --check \"**/*.{html,css,json,js,ts,md}\"",
        "format:run": "prettier --write \"**/*.{html,css,json,js,ts,md}\"",
        "check:types": "tsc -p tsconfig.json --noEmit --skipLibCheck",
        "lint": "eslint source"
    }
}
